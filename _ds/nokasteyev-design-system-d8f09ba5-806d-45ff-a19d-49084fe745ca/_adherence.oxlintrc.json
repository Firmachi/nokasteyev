{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/gallery/**",
              "components/navigation/**",
              "ui_kits/gallery/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bodoni Moda|Archivo|EB Garamond))/i]",
        "message": "Font not provided by the design system. Available: Bodoni Moda, Archivo, EB Garamond."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtistCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:portrait|name|years|discipline|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArtistCard> doesn't accept that prop. Declared props: portrait, name, years, discipline, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtworkCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|title|artist|year|offset|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArtworkCard> doesn't accept that prop. Declared props: src, title, artist, year, offset, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtworkPlate'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|title|artist|year|medium|caption|size|align|style|key|ref|className|style|children)$/]",
        "message": "<ArtworkPlate> doesn't accept that prop. Declared props: src, title, artist, year, medium, caption, size, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtworkPlate'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ArtworkPlate> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtworkPlate'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<ArtworkPlate> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconAfter|onArchive|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconAfter, onArchive, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EraBackdrop'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|position|scrim|fixed|grain|children|style|key|ref|className|style|children)$/]",
        "message": "<EraBackdrop> doesn't accept that prop. Declared props: src, position, scrim, fixed, grain, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EraBackdrop'] > JSXAttribute[name.name='scrim'] > Literal[value!=/^(?:none|bottom|full)$/]",
        "message": "<EraBackdrop> scrim must be one of 'none' | 'bottom' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|note|key|ref|className|style|children)$/]",
        "message": "<FactListItem> doesn't accept that prop. Declared props: label, value, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|size|onArchive|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, size, onArchive, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndexOverlayItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|id|key|ref|className|style|children)$/]",
        "message": "<IndexOverlayItem> doesn't accept that prop. Declared props: label, meta, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='LifeTimelineEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|text|emphasis|key|ref|className|style|children)$/]",
        "message": "<LifeTimelineEntry> doesn't accept that prop. Declared props: year, text, emphasis."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lightbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|src|title|artist|year|medium|onClose|onPrev|onNext|style|key|ref|className|style|children)$/]",
        "message": "<Lightbox> doesn't accept that prop. Declared props: open, src, title, artist, year, medium, onClose, onPrev, onNext, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Prose'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|lead|onArchive|style|key|ref|className|style|children)$/]",
        "message": "<Prose> doesn't accept that prop. Declared props: children, lead, onArchive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|source|onArchive|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, attribution, source, onArchive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|eyebrow|level|align|onArchive|rule|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: children, eyebrow, level, align, onArchive, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeaderNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<SiteHeaderNavItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|onArchive|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, onArchive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|ink|pigment)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'ink' | 'pigment'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineScrubber'] > JSXAttribute > JSXIdentifier[name!=/^(?:years|value|onChange|onArchive|hint|style|key|ref|className|style|children)$/]",
        "message": "<TimelineScrubber> doesn't accept that prop. Declared props: years, value, onChange, onArchive, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|onArchive|subtitle|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, onArchive, subtitle, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
